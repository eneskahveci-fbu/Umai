# Supabase (opsiyonel — yoksa uygulama yerel localStorage modunda çalışır)
# Supabase projen > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Sunucu tarafı varsayılan LLM (opsiyonel — kullanıcı arayüzden kendi anahtarını girebilir)
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
LLM_API_KEY=hf_...

# ── Stripe (opsiyonel — yoksa "Pro'ya Geç" gizlenir, uygulama BYOK ile ücretsiz) ──
STRIPE_SECRET_KEY=sk_test_...
# Pro abonelik fiyatının ID'si (Stripe > Products > Price)
STRIPE_PRICE_ID=price_...
# Webhook imza gizi (Stripe > Developers > Webhooks; uç: /api/billing/webhook)
STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook'un RLS'i aşıp 'subscriptions' tablosuna yazması için (SUNUCU-ONLY, gizli!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Checkout/portal dönüş adresleri için site kökü
NEXT_PUBLIC_SITE_URL=https://craft-coder.vercel.app
