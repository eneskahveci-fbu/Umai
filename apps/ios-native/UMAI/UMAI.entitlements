<?xml version="1.0" encoding="UTF-8"?>
<!--
  UMAI yetkilendirmeleri — bilinçli olarak MİNİMUM.

  İstenmeyen her yetki (konum, kişiler, mikrofon, arka plan…) hem App Store
  incelemesinde "neden gerekiyor?" sorusu doğurur hem de gizlilik vaadini
  zayıflatır. UMAI'nin ihtiyacı yalnızca Keychain'dir: kullanıcının kendi API
  anahtarları orada saklanır.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.umai.app</string>
    </array>
</dict>
</plist>
